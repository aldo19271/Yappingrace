# Salin ke .env.local hanya untuk development lokal. JANGAN commit file .env.
# Di Vercel, isi nilai ini lewat Settings > Environment Variables.

# Connection string Neon (pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# String acak panjang (minimal 32 karakter). HARUS sama dengan JWT_SECRET di Cloudflare.
JWT_SECRET=ganti-dengan-string-acak-panjang

# String acak panjang. HARUS sama dengan GAME_SERVER_SECRET di Cloudflare.
GAME_SERVER_SECRET=ganti-dengan-string-acak-lain

# Alamat WebSocket server game (Cloudflare Worker). Diawali wss://
VITE_WS_URL=wss://yappingrace-ws.NAMA-AKUN.workers.dev
